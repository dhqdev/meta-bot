# Gerado a partir de /etc/nginx/templates (variáveis: BACKEND_UPSTREAM, MT5_UPSTREAM, NGINX_RESOLVER).
# Os upstreams usam variáveis + resolver: o nginx sobe mesmo se o backend ou o mt5 ainda não existirem.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80 default_server;
    server_name _;
    server_tokens off;
    absolute_redirect off;
    resolver ${NGINX_RESOLVER} valid=10s ipv6=off;
    client_max_body_size 1m;
    root /usr/share/nginx/html;

    location = /healthz {
        access_log off;
        return 200 "ok";
    }

    location /api/ {
        set $backend ${BACKEND_UPSTREAM};
        proxy_pass $backend;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_read_timeout 180s;
    }

    location /ws {
        set $backend ${BACKEND_UPSTREAM};
        proxy_pass $backend;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # Confere o login do Meta-Bot antes de abrir o painel do MT5.
    location = /_auth {
        internal;
        set $backend ${BACKEND_UPSTREAM};
        proxy_pass $backend/api/auth/forward;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header Cookie $http_cookie;
        proxy_set_header Host $http_host;
    }

    # Painel web do MetaTrader 5 (KasmVNC com SUBFOLDER=/mt5/): só para quem está logado.
    location /mt5/ {
        auth_request /_auth;
        error_page 401 = @login;
        set $mt5 ${MT5_UPSTREAM};
        proxy_pass $mt5;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_buffering off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    location @login {
        return 302 /;
    }

    location /assets/ {
        include /etc/nginx/snippets/headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    location / {
        include /etc/nginx/snippets/headers.conf;
        add_header Cache-Control "no-cache" always;
        try_files $uri /index.html;
    }
}
