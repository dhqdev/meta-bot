# Copie para .env (docker compose) e preencha. Nunca faça commit do .env.
# Gere valores aleatórios com: openssl rand -hex 32

# Criptografa as chaves salvas no sistema e protege o login (32+ caracteres). GUARDE: se mudar, as chaves salvas precisam ser cadastradas de novo.
MB_SECRET_KEY=
# Senha do PostgreSQL (use só letras e números)
POSTGRES_PASSWORD=
# Chave compartilhada entre o backend e o bridge do MT5 (16+ caracteres)
MT5_BRIDGE_TOKEN=
# Senha do painel web do MT5 (além do login do Meta-Bot)
MT5_VNC_USER=admin
MT5_VNC_PASSWORD=

# Dono do sistema (opcional; sem isso, o código de configuração aparece nos logs do backend)
MB_ADMIN_EMAIL=
MB_ADMIN_PASSWORD=

# true só se houver HTTPS na frente
MB_COOKIE_SECURE=false
WEB_PORT=8080

# IA dos agentes pelo OpenRouter (também dá para cadastrar pela tela, em Config.).
# Cada agente já tem o seu modelo definido; com a chave, a IA liga sozinha.
MB_OPENROUTER_API_KEY=
# Endereço público (identifica o app no painel do OpenRouter)
MB_PUBLIC_URL=http://localhost:8080

# Opcional: login automático na corretora
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
